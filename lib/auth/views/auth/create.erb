<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cadastro - DTO CLI</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    }
    
    .signup-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    
    .signup-card {
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      max-width: 440px;
      width: 100%;
      overflow: hidden;
      animation: slideUp 0.5s ease-out;
    }
    
    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .signup-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      padding: 40px 20px;
      text-align: center;
      color: white;
    }
    
    .signup-header h1 {
      font-size: 32px;
      font-weight: 700;
      margin-bottom: 8px;
      letter-spacing: -0.5px;
    }
    
    .signup-header p {
      margin: 0;
      opacity: 0.95;
      font-size: 15px;
    }
    
    .signup-body {
      padding: 40px 35px;
    }
    
    .form-label {
      font-weight: 600;
      color: #344054;
      margin-bottom: 8px;
      font-size: 14px;
    }
    
    .form-control {
      border: 2px solid #e5e7eb;
      border-radius: 10px;
      padding: 12px 16px;
      font-size: 15px;
      transition: all 0.3s ease;
    }
    
    .form-control:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
      outline: none;
    }
    
    .input-group {
      position: relative;
    }
    
    .input-icon {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #9ca3af;
      font-size: 18px;
      pointer-events: none;
    }
    
    .form-control.with-icon {
      padding-left: 45px;
    }
    
    .btn-signup {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      border: none;
      border-radius: 10px;
      padding: 14px;
      font-size: 16px;
      font-weight: 600;
      color: white;
      transition: all 0.3s ease;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.4);
    }
    
    .btn-signup:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
      background: linear-gradient(135deg, #059669 0%, #047857 100%);
    }
    
    .btn-signup:active {
      transform: translateY(0);
    }
    
    .password-strength {
      height: 4px;
      background: #e5e7eb;
      border-radius: 2px;
      margin-top: 8px;
      overflow: hidden;
    }
    
    .password-strength-bar {
      height: 100%;
      width: 0%;
      transition: all 0.3s ease;
      border-radius: 2px;
    }
    
    .login-link {
      text-align: center;
      padding-top: 20px;
      border-top: 1px solid #f3f4f6;
      color: #6b7280;
      font-size: 14px;
    }
    
    .login-link a {
      color: #667eea;
      text-decoration: none;
      font-weight: 600;
      transition: color 0.2s ease;
    }
    
    .login-link a:hover {
      color: #5a67d8;
      text-decoration: underline;
    }
    
    .form-hint {
      font-size: 12px;
      color: #6b7280;
      margin-top: 6px;
      display: flex;
      align-items: center;
      gap: 4px;
    }
    
    .form-hint i {
      font-size: 14px;
    }
  </style>
</head>
<body>

<div class="signup-container">
  <div class="signup-card">
    <div class="signup-header">
      <h1><i class="bi bi-person-plus"></i> Criar Conta</h1>
      <p>Junte-se ao DTO CLI e comece agora</p>
    </div>
    
    <div class="signup-body">
      <form method="post" action="/create">
        <div class="mb-4">
          <label class="form-label">Nome completo</label>
          <div class="input-group">
            <i class="bi bi-person input-icon"></i>
            <input 
              type="text" 
              name="nome" 
              class="form-control with-icon" 
              placeholder="João Silva"
              required
              autocomplete="name"
              minlength="3"
            >
          </div>
          <div class="form-hint">
            <i class="bi bi-info-circle"></i>
            <span>Como você gostaria de ser chamado</span>
          </div>
        </div>

        <div class="mb-4">
          <label class="form-label">Email</label>
          <div class="input-group">
            <i class="bi bi-envelope input-icon"></i>
            <input 
              type="email" 
              name="email" 
              class="form-control with-icon" 
              placeholder="seu@email.com"
              required
              autocomplete="email"
            >
          </div>
          <div class="form-hint">
            <i class="bi bi-info-circle"></i>
            <span>Utilize um email válido para recuperação de conta</span>
          </div>
        </div>

        <div class="mb-2">
          <label class="form-label">Senha</label>
          <div class="input-group">
            <i class="bi bi-lock input-icon"></i>
            <input 
              type="password" 
              name="password" 
              class="form-control with-icon" 
              placeholder="••••••••"
              required
              autocomplete="new-password"
              minlength="6"
            >
          </div>
          <div class="form-hint">
            <i class="bi bi-shield-check"></i>
            <span>Mínimo de 6 caracteres</span>
          </div>
        </div>

        <button type="submit" class="btn btn-signup w-100 mt-4">
          <i class="bi bi-check-circle me-2"></i>Criar minha conta
        </button>
      </form>

      <div class="login-link">
        Já possui conta? <a href="/login">Faça login</a>
      </div>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>